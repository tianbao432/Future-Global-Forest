!///////////////////////////////////////////////////////////////////////////////////////
! Tianbao forest age and ESA CCI forest-type input 
!///////////////////////////////////////////////////////////////////////////////////////
param "file_lu"        (str "/home/tianbao/run_LPJ_GUESS/ESA_CCI_PFT/data/Tianbao_forest_landcover_1700_2100_15groups.txt")
param "file_luforest"  (str "/home/tianbao/run_LPJ_GUESS/ESA_Tianbao_age/inputs/Tianbao_ST_PFT.txt")

! Optional wet-day keys for the CF input module.
! Daily precipitation remains in file_prec; verify empty-file behavior.
param "file_wetdays" (str "")
param "variable_wetdays" (str "")

param "file_woodharv_prescribed_intens_BL" (str "")
param "file_woodharv_prescribed_intens_NL" (str "")
param "file_woodharv_prescribed_size_preference_BL" (str "")
param "file_woodharv_prescribed_size_preference_NL" (str "")
param "file_tree2globe_para" (str "")

! burned_area_model "SIMFIRE_GLOBAL"	! SIMFIRE_GLOBAL, SIMFIRE_EUROPE  ! use global.ins: burned_area_model "SIMFIRE_GLOBAL"
! npatch_secondarystand 1			! Number of replicate patches to simulate in secondary stands with option forest_init_poolsoil  ! superseded by npatch_secondarystand 5
npatch_disturbedstand 1			! Number of replicate patches to simulate in secondary stands created by prescribed disturbance
npatch_treeinit 1			! Number of patches simulated in stands created at whole tree initialisation
reduce_all_stands 0			! Whether to reduce equal percentage of all stands of a stand type at land cover change
age_limit_reduce 15			! Minimum age of stands to reduce at land cover change

!///////////////////////////////////////////////////////////////////////////////////////
! Setting some flags 
!///////////////////////////////////////////////////////////////////////////////////////
! estinterval 1			 ! Years between establishment events in cohort mode  ! use global.ins: estinterval 5
! npatch 5			     ! Number of replicate patches to simulate  ! use global.ins: npatch 15
npatch_secondarystand 5 ! MMY Number of replicate patches to simulate in secondary stand. Patch number in FOREST stand created from bare ground (type: int, default: 1)
! ifnewalloc 1			 ! Whether to use the new allocation calculations (1), or the original (0)  ! use global.ins: ifnewalloc 1
!coordinates_precision 3 ! Needed for site simulations

!///////////////////////////////////////////////////////////////////////////////////////
! SERIALIZATION SETTINGS
!///////////////////////////////////////////////////////////////////////////////////////
! restart 0                               ! Whether to start from a state file  ! use global.ins: restart 0
! restart_year 399                ! Year to start state file (no setting = after spinup)
! restart_path "./restarts" ! Directory to put state files in

! save_state 0                         ! Whether to save a state file  ! use global.ins: save_state 0
! save_year 399   		         ! Save the state for the year before restart year (here save_year = restart_year, in fact it should equal to restart_year - 1, no setting = after spinup)
! save_path "./restarts"    ! Directory to put state files in

!///////////////////////////////////////////////////////////////////////////////
! Management types
!///////////////////////////////////////////////////////////////////////////////
group "mt_man" (
    relaxed_establishment 1 ! MMY Whether to ignore climate establishment limits at planting (type: bool, default: 0)
    suppress_fire 0         ! MMY Whether to suppress fires
    suppress_disturbance 0  ! MMY Whether to suppress disturbances
    stochmort 1		        ! MMY Whether to use stochastic mortality									 	;  NDRAT TILL 1 240625 !
    stochestab 1			! MMY Whether to use stochastic establishment 
    killgrass_at_cc 1		! MMY Whether to kill grass at clearcut 
    ! MMY@20Apr2026, comment out firstmanageyear to stop using management
    firstmanageyear 1701	! MMY First calender year of management, calendar year when management starts (including suppression of disturbance and fire)
                            ! Must be set if management starts before first historic year (first climate year in trunk code version)
    ! ifclearcut_by_density 1
    ! MMY@20Apr2026, set ifthin_reineke 0 to avoid using Reineke's management	 
)

mt "MT_NL" (
    mt_man
    ifthin_reineke 1 	    ! MMY Whether to use Reineke's rule-based automatic thinning ! No effect unless harvest_system is "clearcut"				! Sim. 3 & 7
    ! delayduecutting 10
    ! rotation_wait_for_cc 1
    firstclearcutyear 2200      ! MMY change from 2011 to 2006 for 2005 init ! First calender year of clearcut
    harvest_system "" !"probability_input" !  "clearcut" 
    ! MMY@20Apr2026, Stefan also doesn't know what SELECTION here means. Mats cannot remember what planting_system means neither, but he thinks this one is harmless when to turn on.
    planting_system "SELECTION"          ! MMY Planting system of management 1, rules for which pfts are planted
    reestab "restricted"        ! MMY@20Apr2026
    selection  "BNE BINE BNS TeNE" 
    )

mt "MT_BL" (
    mt_man
    ifthin_reineke 1 	    ! MMY Whether to use Reineke's rule-based automatic thinning ! No effect unless harvest_system is "clearcut"				! Sim. 3 & 7
    ! delayduecutting 10
    ! rotation_wait_for_cc 1
    firstclearcutyear 2200      ! MMY change from 2011 to 2006 for 2005 init ! First calender year of clearcut
    harvest_system "" !"probability_input" !  "clearcut" 
    ! MMY@20Apr2026, Stefan also doesn't know what SELECTION here means. Mats cannot remember what planting_system means neither, but he thinks this one is harmless when to turn on.
    planting_system "SELECTION"          ! MMY Planting system of management 1, rules for which pfts are planted
    reestab "restricted"        ! MMY@20Apr2026
    selection  "TeBS IBS TeBE TrBE TrIBE TrBR" 
   )
mt "MT_MIX" (
    mt_man
    ifthin_reineke 1 	    ! MMY Whether to use Reineke's rule-based automatic thinning ! No effect unless harvest_system is "clearcut"				! Sim. 3 & 7
    ! delayduecutting 10
    ! rotation_wait_for_cc 1
    firstclearcutyear 2200      ! MMY change from 2011 to 2006 for 2005 init ! First calender year of clearcut
    harvest_system "" !"probability_input" !  "clearcut" 
    ! MMY@20Apr2026, Stefan also doesn't know what SELECTION here means. Mats cannot remember what planting_system means neither, but he thinks this one is harmless when to turn on.
    planting_system ""          ! MMY Planting system of management 1, rules for which pfts are planted
    reestab "all"        ! MMY@20Apr2026
)
!///////////////////////////////////////////////////////////////////////////////
! Forest stand types: ESA CCI four-category area input
!///////////////////////////////////////////////////////////////////////////////
group "st_man" (
    common_stand
    landcover "forest"
    naturalveg "all"
    stinclude 1
)

st "Forest" (
    stinclude 0
)

st "NL" (
    st_man
    management1 "MT_NL"
)

st "BL" (
    st_man
    management1 "MT_BL"
)

st "MIX" (
    st_man
    management1 "MT_MIX"
)


