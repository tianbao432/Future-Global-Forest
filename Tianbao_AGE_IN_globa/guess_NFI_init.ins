!///////////////////////////////////////////////////////////////////////////////
! Run parameters and options
!///////////////////////////////////////////////////////////////////////////////
!nyear_spinup 500       ! MMY@20Apr2026 set in global.ins
! npatch 25			    ! number of replicate patches to simulate ! MMY@20Apr2026 set in custom_info.ins
! npatch_secondarystand 25! MMY@20Apr2026 set in custom_info.ins 
                        ! MMY Number of replicate patches to simulate in secondary stand. Patch number in FOREST stand created from bare ground (type: int, default: 1)

! ifnewalloc 1			! Whether to use the new allocation calculations (1), or the original (0) ! MMY@20Apr2026 set in custom_info.ins
ifvolhght 1			    ! Whether to use the new tree volume to height calculations (1), or the original (0)
ifprintallommort 1 		! Whether to print which mortality function was triggered (1) or not (0)
!file_veg_struct "veg_struct.out"

! MMY search for soil data in up to xx degrees around the EMDI coordinates
searchradius_soil 5

! MMY iftransfer_to_new_stand: Whether to create new stands in transfer_to_new_stand(). 
!                              Required for stand cloning (type: bool, default: 0)
!                           0: new areas of NATURAL and FOREST are represented by a new stand 
!                              with number of patches defined in npatch_secondarystand
!                           1: the history of the stand is transfered to the new stand (with 
!                              different options that can be defined with a combination of 
!                              other parameters: cutfirstyear, res_outtake, killgrass_at_cc)
iftransfer_to_new_stand 1

transfer_level 1

run_landcover 1

run_urban 0                 ! Whether to simulate barren land (1) or not (0)
run_crop 0                  ! Whether to simulate crop vegetation (1) or not (0)
run_forest 1                ! Whether to simulate managed forest (1) or not (0)
run_pasture 0               ! Whether to simulate pasture (1) or not (0)
run_natural 1               ! Whether to simulate natural vegetation (1) or not (0)
run_peatland 0              ! Whether to simulate peatland (1) or not (0)
run_barren 0                ! MMY@14Oct2025 Change to 0 since no barren from LC file. ! Whether to simulate barren land (1) or not (0)
